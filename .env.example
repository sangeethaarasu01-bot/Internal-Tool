# Remote API (default for team / deployed backend)
VITE_API_URL=https://internal-tool-backend-x10p.onrender.com

# Local backend with `uvicorn` on port 8000 — either:
# VITE_API_URL=http://localhost:8000
# or Vite proxy (relative /api URLs — target comes from VITE_API_URL in vite.config):
# VITE_USE_DEV_PROXY=true
# VITE_API_URL=http://localhost:8000
