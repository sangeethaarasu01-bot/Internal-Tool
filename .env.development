# Default: Render backend (no local uvicorn required)
#  VITE_API_URL=https://internal-tool-backend-x10p.onrender.com
#  VITE_USE_DEV_PROXY=false

# Local backend via Vite proxy instead: uncomment below and comment Render URL above
VITE_USE_DEV_PROXY=true
VITE_API_URL=http://localhost:8000
# Large PDFs: optional longer poll wait in ms (default 1200000 = 20 min)
# VITE_EXTRACTION_POLL_MAX_MS=1800000
